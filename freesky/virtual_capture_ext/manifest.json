{
  "manifest_version": 3,
  "name": "FreeSky Tab Capture",
  "version": "1.0",
  "description": "Streams the captured tab's compositor output (H.264 + Opus) to the FreeSky backend for restreaming as HLS.",
  "key": "",
  "permissions": [
    "tabCapture",
    "offscreen",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "sw.js"
  }
}