# Port configuration
PORT=3000
BACKEND_PORT=8005

# API configuration
API_URL=http://localhost:3000
BACKEND_HOST_URI=http://localhost:8005
DADDYLIVE_URI=https://dlhd.st
# Performance configuration
#
# Keep this at 1. start.sh exports it as GRANIAN_WORKERS (the only name reflex
# reads). More than one worker process breaks two things: /api/content URLs are
# encrypted with a per-process key, and each worker gets its own virtual-channel
# session manager, display counter and autostart task -- so several processes
# fight over one X display and one Chrome profile. The backend is async and
# I/O-bound; extra processes buy nothing here. See documentation/VIRTUAL_CHANNELS.md.
WORKERS=1
# Content proxy settings
PROXY_CONTENT=TRUE
# SOCKS5 proxy (optional)
# SOCKS5=127.0.0.1:1080
